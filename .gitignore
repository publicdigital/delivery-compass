node_modules/
data/*.db
# SQLite writes -wal and -shm alongside the database; they hold real rows and were
# caught being staged once, because "*.db" does not match them.
data/*.db-*
data/cache/
.env

# Feedback captured by a deployed instance. Lives in Netlify Forms, never in git.
feedback.db
feedback.db-*

# Raw transcripts from evals/run.sh. Large, and regenerated on every run; the summaries
# (evals/*.md) are what is kept.
evals/results/
